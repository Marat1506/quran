      "ayahs": [
        {
          "number": 6194,
          "text": "Li-ilaafi quraish",
          "numberInSurah": 1,
          "juz": 30,
          "manzil": 7,
          "page": 602,
          "ruku": 548,
          "hizbQuarter": 240,
          "sajda": false
        },
        {
          "number": 6195,
          "text": "Elaafihim rihlatash shitaa-i wass saif",
          "numberInSurah": 2,
          "juz": 30,
          "manzil": 7,
          "page": 602,
          "ruku": 548,
          "hizbQuarter": 240,
          "sajda": false
        },
        {
          "number": 6196,
          "text": "Fal y'abudu rabba haazal-bait",
          "numberInSurah": 3,
          "juz": 30,
          "manzil": 7,
          "page": 602,
          "ruku": 548,
          "hizbQuarter": 240,
          "sajda": false
        },
        {
          "number": 6197,
          "text": "Allazi at'amahum min ju'inw-wa-aamana hum min khawf",
          "numberInSurah": 4,
          "juz": 30,
          "manzil": 7,
          "page": 602,
          "ruku": 548,
