      "numberOfAyahs": 4,
      "ayahs": [
        {
          "number": 6194,
          "text": "Ради единения курейшитов,",
          "numberInSurah": 1,
          "juz": 30,
          "manzil": 7,
          "page": 602,
          "ruku": 548,
          "hizbQuarter": 240,
          "sajda": false
        },
        {
          "number": 6195,
          "text": "единения их во время зимних и летних поездок.",
          "numberInSurah": 2,
          "juz": 30,
          "manzil": 7,
          "page": 602,
          "ruku": 548,
          "hizbQuarter": 240,
          "sajda": false
        },
        {
          "number": 6196,
          "text": "Пусть же они поклоняются Господу этого Дома (Каабы),",
          "numberInSurah": 3,
          "juz": 30,
          "manzil": 7,
          "page": 602,
          "ruku": 548,
          "hizbQuarter": 240,
          "sajda": false
        },
        {
          "number": 6197,
          "text": "Который накормил их после голода и избавил их от страха.",
          "numberInSurah": 4,
          "juz": 30,
          "manzil": 7,
          "page": 602,
          "ruku": 548,
          "hizbQuarter": 240,
          "sajda": false
        }
      ],
