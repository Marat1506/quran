u0628\u0631\u0633\u0645 \u0627\u0644\u0639\u062b\u0645\u0627\u0646\u064a (uthmani)","englishName":"Uthmani","format":"text","type":"quran","direction":"rtl"}},{"number":67,"name":"\u0633\u064f\u0648\u0631\u064e\u0629\u064f \u0627\u0644\u0645\u064f\u0644\u06e1\u0643\u0650","englishName":"Al-Mulk","englishNameTranslation":"The Sovereignty","revelationType":"Meccan","numberOfAyahs":30,"ayahs":[{"number":5242,"text":"Tabaarakal lazee biyadihil mulku wa huwa 'alaa kulli shai-in qadeer","numberInSurah":1,"juz":29,"manzil":7,"page":562,"ruku":496,"hizbQuarter":225,"sajda":false},{"number":5243,"text":"Allazee khalaqal mawta walhayaata liyabluwakum ayyukum ahsanu 'amalaa; wa huwal 'azeezul ghafoor","numberInSurah":2,"juz":29,"manzil":7,"page":562,"ruku":496,"hizbQuarter":225,"sajda":false},{"number":5244,"text":"Allazee khalaqa sab'a samaawaatin tibaaqam maa taraa fee khalqir rahmaani min tafaawutin farji'il basara hal taraa min futoor","numberInSurah":3,"juz":29,"manzil":7,"page":562,"ruku":496,"hizbQuarter":225,"sajda":false},{"number":5245,"text":"Summar ji'il basara karrataini yanqalib ilaikal basaru khaasi'anw wa huwa haseer","numberInSurah":4,"juz":29,"manzil":7,"page":562,"ruku":496,"hizbQuarter":225,"sajda":false},{"number":5246,"text":"Wa laqad zaiyannas samaaa'ad dunyaa bimasaa beeha wa ja'alnaahaa rujoomal lish shayaateeni wa a'tadnaa lahum 'azaabas sa'eer","numberInSurah":5,"juz":29,"manzil":7,"page":562,"ruku":496,"hizbQuarter":225,"sajda":false},{"number":5247,"text":"Wa lillazeena kafaroo bi rabbihim 'azaabu jahannama wa bi'sal maseer","numberInSurah":6,"juz":29,"manzil":7,"page":562,"ruku":496,"hizbQuarter":225,"sajda":false},{"number":5248,"text":"Izaaa ulqoo feehaa sami'oo lahaa shaheeqanw wa hiya tafoor","numberInSurah":7,"juz":29,"manzil":7,"page":562,"ruku":496,"hizbQuarter":225,"sajda":false},{"number":5249,"text":"Takaadu tamayyazu minal ghaizi kullamaaa uliqya feehaa fawjun sa alahum khazanatuhaaa alam yaatikum nazeer","numberInSurah":8,"juz":29,"manzil":7,"page":562,"ruku":496,"hizbQuarter":225,"sajda":false},{"number":5250,"text":"Qaaloo balaa qad jaaa'anaa nazeerun fakazzabnaa wa qulnaa maa nazzalal laahu min shai in in antum illaa fee dalaalin kabeer","numberInSurah":9,"juz":29,"manzil":7,"page":562,"ruku":496,"hizbQuarter":225,"sajda":false},{"number":5251,"text":"Wa qaaloo law kunnaa nasma'u awna'qilu maa kunnaa feee as haabis sa'eer","numberInSurah":10,"juz":29,"manzil":7,"page":562,"ruku":496,"hizbQuarter":225,"sajda":false},{"number":5252,"text":"Fa'tarafoo bizambihim fasuhqal li as haabis sa'eer","numberInSurah":11,"juz":29,"manzil":7,"page":562,"ruku":496,"hizbQuarter":225,"sajda":false},{"number":5253,"text":"Innal lazeena yakhshawna rabbahum bilghaibi lahum maghfiratunw wa ajrun kabeer","numberInSurah":12,"juz":29,"manzil":7,"page":562,"ruku":496,"hizbQuarter":225,"sajda":false},{"number":5254,"text":"Wa asirroo qawlakum awijharoo bihee innahoo 'aleemum bizaatis sudoor","numberInSurah":13,"juz":29,"manzil":7,"page":563,"ruku":496,"hizbQuarter":225,"sajda":false},{"number":5255,"text":"Alaa ya'lamu man khalaq wa huwal lateeful khabeer","numberInSurah":14,"juz":29,"manzil":7,"page":563,"ruku":496,"hizbQuarter":225,"sajda":false},{"number":5256,"text":"Huwal lazee ja'ala lakumul arda zaloolan famshoo fee manaakibihaa wa kuloo mir rizqihee wa ilaihin nushoor","numberInSurah":15,"juz":29,"manzil":7,"page":563,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5257,"text":"'A-amintum man fissamaaa'i aiyakhsifa bi kumul arda fa izaa hiya tamoor","numberInSurah":16,"juz":29,"manzil":7,"page":563,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5258,"text":"Am amintum man fissamaaa'i ai yursila 'alaikum haasiban fasata'lamoona kaifa nazeer","numberInSurah":17,"juz":29,"manzil":7,"page":563,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5259,"text":"Wa laqad kazzabal lazeena min qablihim fakaifa kaana nakeer","numberInSurah":18,"juz":29,"manzil":7,"page":563,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5260,"text":"Awalam yaraw ilat tairi fawqahum saaaffaatinw wa yaqbidn; maa yumsikuhunna illaar rahmaan; innahoo bikulli shai im baseer","numberInSurah":19,"juz":29,"manzil":7,"page":563,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5261,"text":"Amman haazal lazee huwa jundul lakum yansurukum min doonir rahmaan; inilkaafiroona illaa fee ghuroor","numberInSurah":20,"juz":29,"manzil":7,"page":563,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5262,"text":"Amman haazal lazee yarzuqukum in amsaka rizqah; bal lajjoo fee 'utuwwinw wa nufoor","numberInSurah":21,"juz":29,"manzil":7,"page":563,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5263,"text":"Afamai yamshee mukibban 'alaa wajhihee ahdaaa ammany yamshee sawiyyan 'alaa siratim mustaqeem","numberInSurah":22,"juz":29,"manzil":7,"page":563,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5264,"text":"Qul huwal lazee ansha akum wa ja'ala lakumus sam'a wal absaara wal af'idata qaleelam maa tashkuroon","numberInSurah":23,"juz":29,"manzil":7,"page":563,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5265,"text":"Qul huwal lazee zara akum fil ardi wa ilaihi tuhsharoon","numberInSurah":24,"juz":29,"manzil":7,"page":563,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5266,"text":"Wa yaqooloona mataa haazal wa'du in kuntum saadiqeen","numberInSurah":25,"juz":29,"manzil":7,"page":563,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5267,"text":"Qul innamal 'ilmu 'indallaahi wa innamaaa ana nazeerum mubeen","numberInSurah":26,"juz":29,"manzil":7,"page":563,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5268,"text":"Falaammaa ra-awhu zulfatan seee'at wujoohul lazeena kafaroo wa qeela haazal lazee kuntum bihee tadda'oon","numberInSurah":27,"juz":29,"manzil":7,"page":564,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5269,"text":"Qul ara'aytum in ahlaka niyal laahu wa mam ma'iya aw rahimanaa famai-yujeerul kaafireena min 'azaabin aleem","numberInSurah":28,"j