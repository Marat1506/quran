    {
      "number": 99,
      "name": "سُورَةُ الزَّلۡزَلَةِ",
      "englishName": "Az-Zalzala",
      "englishNameTranslation": "The Earthquake",
      "revelationType": "Medinan",
      "numberOfAyahs": 8,
      "ayahs": [
        {
          "number": 6139,
          "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا زُلْزِلَتِ ٱلْأَرْضُ زِلْزَالَهَا",
          "numberInSurah": 1,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 541,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6140,
          "text": "وَأَخْرَجَتِ ٱلْأَرْضُ أَثْقَالَهَا",
          "numberInSurah": 2,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 541,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6141,
          "text": "وَقَالَ ٱلْإِنسَٰنُ مَا لَهَا",
          "numberInSurah": 3,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 541,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6142,
          "text": "يَوْمَئِذٍۢ تُحَدِّثُ أَخْبَارَهَا",
          "numberInSurah": 4,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 541,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6143,
          "text": "بِأَنَّ رَبَّكَ أَوْحَىٰ لَهَا",
          "numberInSurah": 5,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 541,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6144,
          "text": "يَوْمَئِذٍۢ يَصْدُرُ ٱلنَّاسُ أَشْتَاتًۭا لِّيُرَوْا۟ أَعْمَٰلَهُمْ",
          "numberInSurah": 6,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 541,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6145,
          "text": "فَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًۭا يَرَهُۥ",
          "numberInSurah": 7,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 541,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6146,
          "text": "وَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍۢ شَرًّۭا يَرَهُۥ",
          "numberInSurah": 8,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 541,
          "hizbQuarter": 239,
          "sajda": false
        }
      ],
      "edition": {
        "identifier": "quran-uthmani",
        "language": "ar",
        "name": "القرآن الكريم برسم العثماني (uthmani)",
        "englishName": "Uthmani",
        "format": "text",
        "type": "quran",
        "direction": "rtl"
      }
    },
    {
      "number": 99,
      "name": "سُورَةُ الزَّلۡزَلَةِ",
      "englishName": "Az-Zalzala",
      "englishNameTranslation": "The Earthquake",
      "revelationType": "Medinan",
      "numberOfAyahs": 8,
      "ayahs": [
        {
          "number": 6139,
          "text": "Izaa zul zilatil ardu zil zaalaha",
          "numberInSurah": 1,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 541,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6140,
          "text": "Wa akh rajatil ardu athqaalaha",
          "numberInSurah": 2,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 541,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6141,
          "text": "Wa qaalal insaanu ma laha",
          "numberInSurah": 3,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 541,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6142,
          "text": "Yawmaa izin tuhad dithu akhbaaraha",
          "numberInSurah": 4,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 541,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6143,
          "text": "Bi-anna rabbaka awhaa laha",
          "numberInSurah": 5,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 541,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6144,
          "text": "Yawma iziy yas durun naasu ash tatal liyuraw a'maalahum",
          "numberInSurah": 6,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 541,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6145,
          "text": "Famaiy ya'mal mithqala zarratin khai raiy-yarah",
          "numberInSurah": 7,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 541,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6146,
          "text": "Wa maiy-y'amal mithqala zarratin sharraiy-yarah",
          "numberInSurah": 8,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 541,
          "hizbQuarter": 239,
          "sajda": false
        }
      ],
      "edition": {
        "identifier": "en.transliteration",
        "language": "en",
        "name": "Transliteration",
        "englishName": "English Transliteration",
        "format": "text",
        "type": "transliteration",
        "direction": "ltr"
      }
    },
    {
      "number": 99,
      "name": "سُورَةُ الزَّلۡزَلَةِ",
      "englishName": "Az-Zalzala",
      "englishNameTranslation": "The Earthquake",
      "revelationType": "Medinan",
      "numberOfAyahs": 8,
      "ayahs": [
        {
          "number": 6139,
          "text": "Когда земля содрогнется от сотрясений,",
          "numberInSurah": 1,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 541,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6140,
          "text": "когда земля извергнет свою ношу,",
          "numberInSurah": 2,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 541,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6141,
          "text": "и человек спросит, что же с нею,",
          "numberInSurah": 3,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 541,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6142,
          "text": "в тот день она расскажет свои известия,",
          "numberInSurah": 4,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 541,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6143,
          "text": "потому что Господь твой внушит ей это.",
          "numberInSurah": 5,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 541,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6144,
          "text": "В тот день люди выйдут толпами, чтобы им показали их деяния.",
          "numberInSurah": 6,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 541,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6145,
          "text": "Тот, кто сделал добро весом в мельчайшую частицу, увидит его.",
          "numberInSurah": 7,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 541,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6146,
          "text": "И тот, кто сделал зло весом в мельчайшую частицу, увидит его.",
          "numberInSurah": 8,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 541,
          "hizbQuarter": 239,
          "sajda": false
        }
      ],
      "edition": {
        "identifier": "ru.kuliev",
        "language": "ru",
        "name": "Кулиев",
        "englishName": "Elmir Kuliev",
        "format": "text",
        "type": "translation",
        "direction": "ltr"
      }
    }
  ]
}