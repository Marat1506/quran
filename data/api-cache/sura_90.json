{
  "code": 200,
  "status": "OK",
  "data": [
    {
      "number": 90,
      "name": "سُورَةُ البَلَدِ",
      "englishName": "Al-Balad",
      "englishNameTranslation": "The City",
      "revelationType": "Meccan",
      "numberOfAyahs": 20,
      "ayahs": [
        {
          "number": 6024,
          "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِهَٰذَا ٱلْبَلَدِ",
          "numberInSurah": 1,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6025,
          "text": "وَأَنتَ حِلٌّۢ بِهَٰذَا ٱلْبَلَدِ",
          "numberInSurah": 2,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6026,
          "text": "وَوَالِدٍۢ وَمَا وَلَدَ",
          "numberInSurah": 3,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6027,
          "text": "لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِى كَبَدٍ",
          "numberInSurah": 4,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6028,
          "text": "أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌۭ",
          "numberInSurah": 5,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6029,
          "text": "يَقُولُ أَهْلَكْتُ مَالًۭا لُّبَدًا",
          "numberInSurah": 6,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6030,
          "text": "أَيَحْسَبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌ",
          "numberInSurah": 7,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6031,
          "text": "أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ",
          "numberInSurah": 8,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6032,
          "text": "وَلِسَانًۭا وَشَفَتَيْنِ",
          "numberInSurah": 9,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6033,
          "text": "وَهَدَيْنَٰهُ ٱلنَّجْدَيْنِ",
          "numberInSurah": 10,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6034,
          "text": "فَلَا ٱقْتَحَمَ ٱلْعَقَبَةَ",
          "numberInSurah": 11,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6035,
          "text": "وَمَآ أَدْرَىٰكَ مَا ٱلْعَقَبَةُ",
          "numberInSurah": 12,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6036,
          "text": "فَكُّ رَقَبَةٍ",
          "numberInSurah": 13,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6037,
          "text": "أَوْ إِطْعَٰمٌۭ فِى يَوْمٍۢ ذِى مَسْغَبَةٍۢ",
          "numberInSurah": 14,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6038,
          "text": "يَتِيمًۭا ذَا مَقْرَبَةٍ",
          "numberInSurah": 15,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6039,
          "text": "أَوْ مِسْكِينًۭا ذَا مَتْرَبَةٍۢ",
          "numberInSurah": 16,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6040,
          "text": "ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُوا۟ وَتَوَاصَوْا۟ بِٱلصَّبْرِ وَتَوَاصَوْا۟ بِٱلْمَرْحَمَةِ",
          "numberInSurah": 17,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6041,
          "text": "أُو۟لَٰٓئِكَ أَصْحَٰبُ ٱلْمَيْمَنَةِ",
          "numberInSurah": 18,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6042,
          "text": "وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَٰتِنَا هُمْ أَصْحَٰبُ ٱلْمَشْـَٔمَةِ",
          "numberInSurah": 19,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6043,
          "text": "عَلَيْهِمْ نَارٌۭ مُّؤْصَدَةٌۢ",
          "numberInSurah": 20,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        }
      ],
      "edition": {
        "identifier": "quran-uthmani",
        "language": "ar",
        "name": "القرآن الكريم برسم العثماني (uthmani)",
        "englishName": "Uthmani",
        "format": "text",
        "type": "quran",
        "direction": "rtl"
      }
    },
    {
      "number": 90,
      "name": "سُورَةُ البَلَدِ",
      "englishName": "Al-Balad",
      "englishNameTranslation": "The City",
      "revelationType": "Meccan",
      "numberOfAyahs": 20,
      "ayahs": [
        {
          "number": 6024,
          "text": "Laaa uqsimu bihaazal balad",
          "numberInSurah": 1,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6025,
          "text": "Wa anta hillum bihaazal balad",
          "numberInSurah": 2,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6026,
          "text": "Wa waalidinw wa maa walad",
          "numberInSurah": 3,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6027,
          "text": "Laqad khalaqnal insaana fee kabad",
          "numberInSurah": 4,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6028,
          "text": "Ayahsabu al-lai yaqdira 'alaihi ahad",
          "numberInSurah": 5,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6029,
          "text": "Yaqoolu ahlaktu maalal lubadaa",
          "numberInSurah": 6,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6030,
          "text": "Ayahsabu al lam yarahooo ahad",
          "numberInSurah": 7,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6031,
          "text": "Alam naj'al lahoo 'aynayn",
          "numberInSurah": 8,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6032,
          "text": "Wa lisaananw wa shafatayn",
          "numberInSurah": 9,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6033,
          "text": "Wa hadaynaahun najdayn",
          "numberInSurah": 10,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6034,
          "text": "Falaq tahamal-'aqabah",
          "numberInSurah": 11,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6035,
          "text": "Wa maaa adraaka mal'aqabah",
          "numberInSurah": 12,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6036,
          "text": "Fakku raqabah",
          "numberInSurah": 13,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6037,
          "text": "Aw it'aamun fee yawmin zee masghabah",
          "numberInSurah": 14,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6038,
          "text": "Yateeman zaa maqrabah",
          "numberInSurah": 15,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6039,
          "text": "Aw miskeenan zaa matrabah",
          "numberInSurah": 16,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6040,
          "text": "Summa kaana minal lazeena aamanoo wa tawaasaw bissabri wa tawaasaw bilmarhamah",
          "numberInSurah": 17,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6041,
          "text": "Ulaaa'ika As-haabul maimanah",
          "numberInSurah": 18,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6042,
          "text": "Wallazeena kafaroo bi aayaatinaa hum as-haabul Mash'amah",
          "numberInSurah": 19,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6043,
          "text": "Alaihim naarum mu'sadah",
          "numberInSurah": 20,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        }
      ],
      "edition": {
        "identifier": "en.transliteration",
        "language": "en",
        "name": "Transliteration",
        "englishName": "English Transliteration",
        "format": "text",
        "type": "transliteration",
        "direction": "ltr"
      }
    },
    {
      "number": 90,
      "name": "سُورَةُ البَلَدِ",
      "englishName": "Al-Balad",
      "englishNameTranslation": "The City",
      "revelationType": "Meccan",
      "numberOfAyahs": 20,
      "ayahs": [
        {
          "number": 6024,
          "text": "Нет, клянусь этим городом (Меккой)!",
          "numberInSurah": 1,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6025,
          "text": "Ты обитаешь в этом городе (или Тебе будет дозволено сражаться в этом городе).",
          "numberInSurah": 2,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6026,
          "text": "Клянусь родителем и тем, кого он породил (Адамом и его потомством, или Ибрахимом и его потомками, в том числе Исмаилом и Мухаммадом)!",
          "numberInSurah": 3,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6027,
          "text": "Мы создали человека в тяготах.",
          "numberInSurah": 4,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6028,
          "text": "Неужели он полагает, что никто не справится с ним?",
          "numberInSurah": 5,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6029,
          "text": "Он говорит: «Я погубил богатство несметное!».",
          "numberInSurah": 6,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6030,
          "text": "Неужели он полагает, что никто не видел его?",
          "numberInSurah": 7,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6031,
          "text": "Разве Мы не наделили его двумя глазами,",
          "numberInSurah": 8,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6032,
          "text": "языком и двумя устами?",
          "numberInSurah": 9,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6033,
          "text": "Разве Мы не указали ему на две восходящие тропы?",
          "numberInSurah": 10,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6034,
          "text": "Но он не стал преодолевать крутую тропу.",
          "numberInSurah": 11,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6035,
          "text": "Откуда ты мог знать, что такое крутая тропа?",
          "numberInSurah": 12,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6036,
          "text": "Это - освобождение раба",
          "numberInSurah": 13,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6037,
          "text": "или кормление в голодный день",
          "numberInSurah": 14,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6038,
          "text": "сироту из числа родственников",
          "numberInSurah": 15,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6039,
          "text": "или приникшего к земле бедняка.",
          "numberInSurah": 16,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6040,
          "text": "А после этого надо быть одним из тех, которые уверовали и заповедали друг другу терпение и заповедали друг другу милосердие.",
          "numberInSurah": 17,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6041,
          "text": "Таковы люди правой стороны.",
          "numberInSurah": 18,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6042,
          "text": "Те же, которые не уверовали в Наши знамения, являются людьми левой стороны,",
          "numberInSurah": 19,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        },
        {
          "number": 6043,
          "text": "над которыми сомкнется Огонь.",
          "numberInSurah": 20,
          "juz": 30,
          "manzil": 7,
          "page": 594,
          "ruku": 532,
          "hizbQuarter": 238,
          "sajda": false
        }
      ],
      "edition": {
        "identifier": "ru.kuliev",
