    },
    {
      "number": 94,
      "name": "سُورَةُ الشَّرۡحِ",
      "englishName": "Ash-Sharh",
      "englishNameTranslation": "The Consolation",
      "revelationType": "Meccan",
      "numberOfAyahs": 8,
      "ayahs": [
        {
          "number": 6091,
          "text": "Разве Мы не раскрыли для тебя грудь твою?",
          "numberInSurah": 1,
          "juz": 30,
          "manzil": 7,
          "page": 596,
          "ruku": 536,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6092,
          "text": "и не сняли с тебя ношу,",
          "numberInSurah": 2,
          "juz": 30,
          "manzil": 7,
          "page": 596,
          "ruku": 536,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6093,
          "text": "которая отягощала твою спину?",
          "numberInSurah": 3,
          "juz": 30,
          "manzil": 7,
          "page": 596,
          "ruku": 536,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6094,
          "text": "Разве Мы не возвеличили для тебя славу твою?",
          "numberInSurah": 4,
          "juz": 30,
          "manzil": 7,
          "page": 596,
          "ruku": 536,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6095,
          "text": "Воистину, за каждой тягостью наступает облегчение.",
          "numberInSurah": 5,
          "juz": 30,
          "manzil": 7,
          "page": 596,
          "ruku": 536,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6096,
          "text": "За каждой тягостью наступает облегчение.",
          "numberInSurah": 6,
          "juz": 30,
          "manzil": 7,
          "page": 596,
          "ruku": 536,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6097,
          "text": "Посему, как только освободишься, будь деятелен (как только освободишься от мирских дел, усердно поклоняйся Аллаху, или как только завершишь намаз, усердно взывай к Аллаху с молитвами)",
          "numberInSurah": 7,
          "juz": 30,
          "manzil": 7,
          "page": 596,
          "ruku": 536,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6098,
          "text": "и устремись к своему Господу.",
          "numberInSurah": 8,
          "juz": 30,
          "manzil": 7,
          "page": 596,
          "ruku": 536,
          "hizbQuarter": 239,
          "sajda": false
        }
      ],
      "edition": {
