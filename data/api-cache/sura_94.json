    },
    {
      "number": 94,
      "name": "سُورَةُ الشَّرۡحِ",
      "englishName": "Ash-Sharh",
      "englishNameTranslation": "The Consolation",
      "revelationType": "Meccan",
      "numberOfAyahs": 8,
      "ayahs": [
        {
          "number": 6091,
          "text": "Alam nashrah laka sadrak",
          "numberInSurah": 1,
          "juz": 30,
          "manzil": 7,
          "page": 596,
          "ruku": 536,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6092,
          "text": "Wa wa d'ana 'anka wizrak",
          "numberInSurah": 2,
          "juz": 30,
          "manzil": 7,
          "page": 596,
          "ruku": 536,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6093,
          "text": "Allazee anqada zahrak",
          "numberInSurah": 3,
          "juz": 30,
          "manzil": 7,
          "page": 596,
          "ruku": 536,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6094,
          "text": "Wa raf 'ana laka zikrak",
          "numberInSurah": 4,
          "juz": 30,
          "manzil": 7,
          "page": 596,
          "ruku": 536,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6095,
          "text": "Fa inna ma'al usri yusra",
          "numberInSurah": 5,
          "juz": 30,
          "manzil": 7,
          "page": 596,
          "ruku": 536,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6096,
          "text": "Inna ma'al 'usri yusra",
          "numberInSurah": 6,
          "juz": 30,
          "manzil": 7,
          "page": 596,
          "ruku": 536,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6097,
          "text": "Fa iza faragh ta fansab",
          "numberInSurah": 7,
          "juz": 30,
          "manzil": 7,
          "page": 596,
          "ruku": 536,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6098,
          "text": "Wa ilaa rabbika far ghab",
          "numberInSurah": 8,
          "juz": 30,
          "manzil": 7,
          "page": 596,
          "ruku": 536,
          "hizbQuarter": 239,
          "sajda": false
        }
      ],
      "edition": {
        "identifier": "en.transliteration",
        "language": "en",
        "name": "Transliteration",
