  "data": [
    {
      "number": 100,
      "name": "سُورَةُ العَادِيَاتِ",
      "englishName": "Al-Aadiyaat",
      "englishNameTranslation": "The Chargers",
      "revelationType": "Meccan",
      "numberOfAyahs": 11,
      "ayahs": [
        {
          "number": 6147,
          "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْعَٰدِيَٰتِ ضَبْحًۭا",
          "numberInSurah": 1,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 542,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6148,
          "text": "فَٱلْمُورِيَٰتِ قَدْحًۭا",
          "numberInSurah": 2,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 542,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6149,
          "text": "فَٱلْمُغِيرَٰتِ صُبْحًۭا",
          "numberInSurah": 3,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 542,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6150,
          "text": "فَأَثَرْنَ بِهِۦ نَقْعًۭا",
          "numberInSurah": 4,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 542,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6151,
          "text": "فَوَسَطْنَ بِهِۦ جَمْعًا",
          "numberInSurah": 5,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 542,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6152,
          "text": "إِنَّ ٱلْإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٌۭ",
          "numberInSurah": 6,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 542,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6153,
          "text": "وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌۭ",
          "numberInSurah": 7,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 542,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6154,
          "text": "وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ",
          "numberInSurah": 8,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 542,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6155,
          "text": "۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ",
          "numberInSurah": 9,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 542,
          "hizbQuarter": 240,
          "sajda": false
        },
        {
          "number": 6156,
          "text": "وَحُصِّلَ مَا فِى ٱلصُّدُورِ",
          "numberInSurah": 10,
          "juz": 30,
          "manzil": 7,
          "page": 600,
          "ruku": 542,
          "hizbQuarter": 240,
          "sajda": false
        },
        {
          "number": 6157,
          "text": "إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍۢ لَّخَبِيرٌۢ",
          "numberInSurah": 11,
          "juz": 30,
          "manzil": 7,
          "page": 600,
          "ruku": 542,
          "hizbQuarter": 240,
          "sajda": false
        }
      ],
      "edition": {
        "identifier": "quran-uthmani",
        "language": "ar",
        "name": "القرآن الكريم برسم العثماني (uthmani)",
        "englishName": "Uthmani",
        "format": "text",
        "type": "quran",
        "direction": "rtl"
      }
    },
    {
      "number": 100,
      "name": "سُورَةُ العَادِيَاتِ",
      "englishName": "Al-Aadiyaat",
      "englishNameTranslation": "The Chargers",
      "revelationType": "Meccan",
      "numberOfAyahs": 11,
      "ayahs": [
        {
          "number": 6147,
          "text": "Wal'aadi yaati dabha",
          "numberInSurah": 1,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 542,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6148,
          "text": "Fal moori yaati qadha",
          "numberInSurah": 2,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 542,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6149,
          "text": "Fal mugheeraati subha",
          "numberInSurah": 3,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 542,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6150,
          "text": "Fa atharna bihee naq'a",
          "numberInSurah": 4,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 542,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6151,
          "text": "Fawa satna bihee jam'a",
          "numberInSurah": 5,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 542,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6152,
          "text": "Innal-insana lirabbihee lakanood",
          "numberInSurah": 6,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 542,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6153,
          "text": "Wa innahu 'alaa zaalika la shaheed",
          "numberInSurah": 7,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 542,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6154,
          "text": "Wa innahu lihubbil khairi la shadeed",
          "numberInSurah": 8,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 542,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6155,
          "text": "Afala ya'lamu iza b'uthira ma filquboor",
          "numberInSurah": 9,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 542,
          "hizbQuarter": 240,
          "sajda": false
        },
        {
          "number": 6156,
          "text": "Wa hussila maa fis sudoor",
          "numberInSurah": 10,
          "juz": 30,
          "manzil": 7,
          "page": 600,
          "ruku": 542,
          "hizbQuarter": 240,
          "sajda": false
        },
        {
          "number": 6157,
          "text": "Inna rabbahum bihim yauma 'izil la khabeer",
          "numberInSurah": 11,
          "juz": 30,
          "manzil": 7,
          "page": 600,
          "ruku": 542,
          "hizbQuarter": 240,
          "sajda": false
        }
      ],
      "edition": {
        "identifier": "en.transliteration",
        "language": "en",
        "name": "Transliteration",
        "englishName": "English Transliteration",
        "format": "text",
        "type": "transliteration",
        "direction": "ltr"
      }
    },
    {
      "number": 100,
      "name": "سُورَةُ العَادِيَاتِ",
      "englishName": "Al-Aadiyaat",
      "englishNameTranslation": "The Chargers",
      "revelationType": "Meccan",
      "numberOfAyahs": 11,
      "ayahs": [
        {
          "number": 6147,
          "text": "Клянусь скачущими, запыхаясь!",
          "numberInSurah": 1,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 542,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6148,
          "text": "Клянусь высекающими искры копытами!",
          "numberInSurah": 2,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 542,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6149,
          "text": "Клянусь нападающими на заре!",
          "numberInSurah": 3,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 542,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6150,
          "text": "Тем самым они поднимают столб пыли",
          "numberInSurah": 4,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 542,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6151,
          "text": "и врываются с ним (со столбом пыли или с всадником) в гущу.",
          "numberInSurah": 5,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 542,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6152,
          "text": "Воистину, человек неблагодарен своему Господу,",
          "numberInSurah": 6,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 542,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6153,
          "text": "и он сам является тому свидетелем.",
          "numberInSurah": 7,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 542,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6154,
          "text": "Воистину, он страстно любит блага.",
          "numberInSurah": 8,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 542,
          "hizbQuarter": 239,
          "sajda": false
        },
        {
          "number": 6155,
          "text": "Неужели он не знает, что, когда будет опрокинуто то, что в могилах,",
          "numberInSurah": 9,
          "juz": 30,
          "manzil": 7,
          "page": 599,
          "ruku": 542,
          "hizbQuarter": 240,
          "sajda": false
        },
        {
          "number": 6156,
          "text": "и когда обнаружится то, что в груди,",
          "numberInSurah": 10,
          "juz": 30,
          "manzil": 7,
          "page": 600,
          "ruku": 542,
          "hizbQuarter": 240,
          "sajda": false
        },
        {
          "number": 6157,
          "text": "в тот день Господь их будет осведомлен о них?",
          "numberInSurah": 11,
          "juz": 30,
          "manzil": 7,
          "page": 600,
          "ruku": 542,
          "hizbQuarter": 240,
          "sajda": false
        }
      ],
      "edition": {
        "identifier": "ru.kuliev",
        "language": "ru",
        "name": "Кулиев",
        "englishName": "Elmir Kuliev",
        "format": "text",
        "type": "translation",
        "direction": "ltr"
      }
    }
  ]
}