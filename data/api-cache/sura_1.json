          "juz": 1,
          "manzil": 1,
          "page": 1,
          "ruku": 1,
          "hizbQuarter": 1,
          "sajda": false
        },
        {
          "number": 5,
          "text": "Iyyaaka na'budu wa lyyaaka nasta'een",
          "numberInSurah": 5,
          "juz": 1,
          "manzil": 1,
          "page": 1,
          "ruku": 1,
          "hizbQuarter": 1,
          "sajda": false
        },
        {
